{
	"schemaVersion": 1,
	"id": "lettered-notetaking",
	"version": "${version}",
	"name": "Lettered Notetaking",
	"description": "This mod is a richly integrated note-taking mod!",
	"authors": [
		"Inklingbot"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/lettered-notetaking/icon.png",
	"environment": "*",
	"entrypoints": {
